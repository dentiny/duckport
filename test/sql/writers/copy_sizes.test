# name: test/sql/writers/copy_sizes.test
# description: Shared COPY target file size validation before destination I/O
# group: [sql]

require duckport

foreach format duckport_lance duckport_parquet duckport_iceberg

foreach value -1 0 NULL 1.5 9223372036854775808 true '1024'

statement error
COPY (SELECT 1 AS id) TO '{TEST_DIR}/invalid' (FORMAT ${format}, TARGET_FILE_SIZE ${value});
----
target_file_size

endloop

statement error
COPY (SELECT 1 AS id) TO '{TEST_DIR}/invalid' (FORMAT ${format}, TARGET_FILE_SIZE);
----
target_file_size

endloop

# No catalog server runs here: unsupported Blob requests must fail before I/O.
foreach format duckport_parquet duckport_iceberg

foreach option blob_inline_size_threshold blob_dedicated_size_threshold

statement error
COPY (SELECT 'file:///unused.bin' AS payload) TO 'tests.people'
(FORMAT ${format}, APPEND, CATALOG_URI 'http://127.0.0.1:1', STORAGE_ROOT '{TEST_DIR}', ${option} 1);
----
blob handle configuration

endloop

statement error
COPY (SELECT 'file:///unused.bin' AS payload) TO 'tests.people'
(FORMAT ${format}, APPEND, CATALOG_URI 'http://127.0.0.1:1', STORAGE_ROOT '{TEST_DIR}', BLOB_COLUMNS ('payload'));
----
blob handle configuration

endloop
