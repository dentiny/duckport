# name: test/sql/writers/extra_options.test
# description: COPY forwards EXTRA_OPTIONS to the source reader
# group: [sql]

require duckport

require parquet

statement ok
COPY (SELECT content_url AS content, text_url FROM duckport_scan_pmc('testdata/pmc/metadata.json'))
TO '{TEST_DIR}/pmc_txt' (FORMAT duckport_parquet, EXTRA_OPTIONS MAP {'content_format': 'txt'});

query I
SELECT content = text_url FROM read_parquet('{TEST_DIR}/pmc_txt/*.parquet');
----
true

statement error
COPY (SELECT * FROM duckport_scan_pmc('testdata/pmc/metadata.json', content_format := 'pdf'))
TO '{TEST_DIR}/duplicate_option' (FORMAT duckport_parquet, EXTRA_OPTIONS {'content_format': 'txt'});
----
EXTRA_OPTIONS duplicates reader option

statement error
COPY (SELECT * FROM duckport_scan_pmc('testdata/pmc/metadata.json'))
TO '{TEST_DIR}/unknown_option' (FORMAT duckport_parquet, EXTRA_OPTIONS {'not_a_reader_option': 'txt'});
----
not_a_reader_option
