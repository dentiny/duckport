# name: test/sql/writers/atif_layouts.test
# description: ATIF COPY stores inline/packed/dedicated blobs, verified after deleting sources
# group: [sql]

require duckport

require duckport_test_fixture

statement ok
SELECT duckport_fixture_write('{TEST_DIR}/input dir/atif-image.png', repeat('x', 2097153)::BLOB);

statement ok
SELECT duckport_fixture_write('{TEST_DIR}/input dir/atif-audio.wav', (SELECT content FROM read_blob('testdata/atif/atif-audio.wav')));

# Two trajectories let a filter exercise row selection through the scan/COPY path.
statement ok
SELECT duckport_fixture_write('{TEST_DIR}/input dir/trajectory.jsonl',
    encode((SELECT content || chr(10) || content FROM read_text('testdata/atif/trajectory_media.json'))));

statement ok
CREATE TABLE atif_layout_input AS
SELECT trajectory_id, steps AS renamed_steps
FROM duckport_scan_atif('{TEST_DIR}/input dir/trajectory.jsonl', batch_size := 2)
WHERE source_record_index = 2;

query I
SELECT ends_with(renamed_steps[1].message[2].source.path, '/input%20dir/atif-image.png') FROM atif_layout_input;
----
true

# Equality boundaries: size == inline is inline; size == dedicated is packed.
foreach layout,inline,dedicated inline,2097153,2097154 packed,0,2097153 dedicated,0,1

statement ok
COPY atif_layout_input TO '{TEST_DIR}/atif_${layout}.lance'
(FORMAT duckport_lance, BLOB_INLINE_SIZE_THRESHOLD ${inline}, BLOB_DEDICATED_SIZE_THRESHOLD ${dedicated});

endloop

statement ok
SELECT duckport_fixture_remove('{TEST_DIR}/input dir/trajectory.jsonl');

statement ok
SELECT duckport_fixture_remove('{TEST_DIR}/input dir/atif-image.png');

statement ok
SELECT duckport_fixture_remove('{TEST_DIR}/input dir/atif-audio.wav');

# These assertions inspect actual persisted descriptors, not requested thresholds.
foreach field renamed_steps.message.source.path renamed_steps.observation.results.content.source.path

query T
SELECT duckport_fixture_blob_layout('{TEST_DIR}/atif_inline.lance', '${field}');
----
{"inline":2,"packed":0,"dedicated":0,"external":0,"managed":0}

query T
SELECT duckport_fixture_blob_layout('{TEST_DIR}/atif_packed.lance', '${field}');
----
{"inline":0,"packed":2,"dedicated":0,"external":0,"managed":0}

query T
SELECT duckport_fixture_blob_layout('{TEST_DIR}/atif_dedicated.lance', '${field}');
----
{"inline":0,"packed":0,"dedicated":2,"external":0,"managed":0}

endloop

restart no_extension_load

statement ok
LOAD '{BUILD_DIRECTORY}/extension/lance/lance.duckdb_extension';

foreach layout inline packed dedicated

query IIIIT
SELECT renamed_steps[1].message[2].source.path = repeat('x', 2097153)::BLOB,
       renamed_steps[1].message[3].source.path = (SELECT content FROM read_blob('testdata/atif/atif-audio.wav')),
       renamed_steps[2].observation.results[1].content[2].source.path = repeat('x', 2097153)::BLOB,
       renamed_steps[2].observation.results[1].content[3].source.path = (SELECT content FROM read_blob('testdata/atif/atif-audio.wav')),
       decode(renamed_steps[1].message[1].text)
FROM '{TEST_DIR}/atif_${layout}.lance';
----
true	true	true	true	hello 你好🙂

endloop
