# name: test/sql/writers/concurrency.test
# description: Default and automatic writers, read concurrency overrides and validation
# group: [sql]

require duckport
require parquet

statement ok
SET threads = 8;

# Omitted write concurrency stays serial even with multiple DuckDB threads.
statement ok
COPY (SELECT i AS id FROM range(10000) t(i))
TO '{TEST_DIR}/default' (FORMAT duckport_parquet);

query III
SELECT count(*), sum(id), (SELECT count(*) FROM glob('{TEST_DIR}/default/*.parquet'))
FROM read_parquet('{TEST_DIR}/default/*.parquet');
----
10000	49995000	1

statement ok
COPY (SELECT * FROM duckport_scan_csv('testdata/multifile/*.csv', header := true, read_concurrency := 1))
TO '{TEST_DIR}/auto' (FORMAT duckport_parquet, READ_CONCURRENCY 'AuTo', WRITE_CONCURRENCY 'auto', TARGET_FILE_SIZE 1048576);

query II
SELECT count(*), sum(id) FROM read_parquet('{TEST_DIR}/auto/*.parquet');
----
3	6

# Auto must also respect ordered output; fixed writers and rollover have separate suites.
statement ok
COPY (SELECT i AS id FROM range(10000) t(i) ORDER BY i DESC)
TO '{TEST_DIR}/ordered' (FORMAT duckport_parquet, WRITE_CONCURRENCY 'auto', PRESERVE_ORDER true);

query I
SELECT count(*) FILTER (WHERE id != 10000 - position)
FROM (SELECT id, row_number() OVER () AS position FROM read_parquet('{TEST_DIR}/ordered/*.parquet'));
----
0

statement error
COPY (SELECT 1 AS id) TO '{TEST_DIR}/invalid_order'
(FORMAT duckport_parquet, WRITE_CONCURRENCY 2, PRESERVE_ORDER true);
----
PRESERVE_ORDER true requires WRITE_CONCURRENCY 1

foreach option READ_CONCURRENCY WRITE_CONCURRENCY

foreach value 0 'invalid' NULL

statement error
COPY (SELECT 1 AS id) TO '{TEST_DIR}/invalid' (FORMAT duckport_parquet, {option} {value});
----
requires 'auto' or a positive integer

endloop

endloop

statement error
SELECT * FROM duckport_scan_csv('testdata/multifile/a.csv', read_concurrency := 0);
----
READ_CONCURRENCY requires 'auto' or a positive integer

statement error
COPY (SELECT 1 AS id) TO '{TEST_DIR}/old_option' (FORMAT duckport_parquet, FILE_COUNT 2);
----
Unrecognized option "file_count"

# Automatic reads follow threads, including values above four.
query TT
EXPLAIN (ANALYZE, FORMAT JSON) SELECT * FROM duckport_scan_csv('testdata/multifile/*.csv', header := true);
----
analyzed_plan	<REGEX>:.*Read concurrency.*8.*auto limit.*

# COPY overrides a scan's explicit setting with either auto or an integer.
query TT
EXPLAIN (ANALYZE, FORMAT JSON) COPY (SELECT * FROM duckport_scan_csv('testdata/multifile/*.csv', header := true, read_concurrency := 1))
TO '{TEST_DIR}/analyzed_auto' (FORMAT duckport_parquet, READ_CONCURRENCY 'auto');
----
analyzed_plan	<REGEX>:.*Read concurrency.*8.*auto limit.*

query TT
EXPLAIN (ANALYZE, FORMAT JSON) COPY (SELECT * FROM duckport_scan_csv('testdata/multifile/*.csv', header := true, read_concurrency := 1))
TO '{TEST_DIR}/analyzed_fixed' (FORMAT duckport_parquet, READ_CONCURRENCY 2);
----
analyzed_plan	<REGEX>:.*Read concurrency.*2.*explicit limit.*

# Omitting the COPY override preserves the scan's explicit setting.
query TT
EXPLAIN (ANALYZE, FORMAT JSON) COPY (SELECT * FROM duckport_scan_csv('testdata/multifile/*.csv', header := true, read_concurrency := 1))
TO '{TEST_DIR}/analyzed_inherited' (FORMAT duckport_parquet);
----
analyzed_plan	<REGEX>:.*Read concurrency.*1.*explicit limit.*
