# name: test/sql/writers/copy_framework.test
# description: COPY framework modes, stubs, and access checks
# group: [sql]

require duckport

# EXPLAIN binds the schema and options without opening a writer.
statement ok
EXPLAIN COPY (SELECT 1 AS id, [1, NULL] AS items) TO '__TEST_DIR__/copy_stub' (FORMAT duckport_lance);

statement ok
EXPLAIN COPY (SELECT 1 AS id) TO '__TEST_DIR__/copy_stub' (FORMAT duckport_parquet, APPEND);

statement ok
EXPLAIN COPY (SELECT 1 AS id) TO '__TEST_DIR__/copy_stub' (FORMAT duckport_iceberg, OVERWRITE);

query I
COPY (SELECT 1 AS id) TO '__TEST_DIR__/copy_stub' (FORMAT duckport_lance);
----
1

# An empty query must still open a sink and fail rather than report false success.
statement error
COPY (SELECT 1 AS id WHERE false) TO '__TEST_DIR__/copy_stub' (FORMAT duckport_parquet);
----
DuckPort parquet sink is not implemented yet

statement error
COPY (SELECT 1 AS id) TO '__TEST_DIR__/copy_stub' (FORMAT duckport_iceberg);
----
DuckPort iceberg sink is not implemented yet

statement error
EXPLAIN COPY (SELECT 1 AS id) TO '__TEST_DIR__/copy_stub' (FORMAT duckport_lance, APPEND, OVERWRITE);
----
Only one of APPEND or OVERWRITE

statement error
EXPLAIN COPY (SELECT 1 AS id) TO '__TEST_DIR__/copy_stub' (FORMAT duckport_lance, APPEND NULL);
----
NULL

statement error
EXPLAIN COPY (SELECT 1 AS id) TO '__TEST_DIR__/copy_stub' (FORMAT duckport_lance, PARTITION_BY (id));
----
Unsupported DuckPort COPY option

statement error
EXPLAIN COPY (SELECT 1 AS id) TO '__TEST_DIR__/copy_stub' (FORMAT duckport_lance, USE_TMP_FILE true);
----
Unsupported DuckPort COPY option

statement error
EXPLAIN COPY (SELECT 1 AS id) TO '__TEST_DIR__/copy_stub' (FORMAT duckport_lance, PER_THREAD_OUTPUT true);
----
Unsupported DuckPort COPY option

statement error
EXPLAIN COPY (SELECT 1 AS id) TO '__TEST_DIR__/copy_stub' (FORMAT duckport_lance, PRESERVE_ORDER true);
----
Unsupported DuckPort COPY option

statement ok
PREPARE copy_stub AS COPY (SELECT 1 AS id) TO '__TEST_DIR__/copy_stub' (FORMAT duckport_lance, OVERWRITE);

query I
EXECUTE copy_stub;
----
1

statement ok
SET enable_external_access = false;

statement error
EXPLAIN COPY (SELECT 1 AS id) TO '__TEST_DIR__/copy_stub' (FORMAT duckport_lance);
----
Permission

statement error
EXECUTE copy_stub;
----
Permission
