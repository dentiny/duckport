# name: test/sql/writers/parquet.test
# description: COPY to Parquet directories and validate with DuckDB's native reader
# group: [sql]

require duckport

require parquet

statement ok
COPY (
    SELECT id::BIGINT AS id, name, [id::BIGINT, NULL] AS numbers,
           CASE id WHEN 1 THEN unhex('00FF0102') WHEN 2 THEN ''::BLOB END AS bytes
    FROM duckport_scan_parquet('testdata/parquet/people.parquet', batch_size := 1)
) TO '{TEST_DIR}/output' (FORMAT duckport_parquet, COLUMN_COMPRESSION {'name': 'zstd'}, COLUMN_COMPRESSION_LEVEL {'name': 3});

statement ok
COPY (SELECT 4::BIGINT AS id, 'appended' AS name, [4::BIGINT, NULL] AS numbers, NULL::BLOB AS bytes)
TO '{TEST_DIR}/output' (FORMAT duckport_parquet, APPEND);

query ITIT
SELECT id, name, numbers IS NOT DISTINCT FROM [id, NULL], hex(bytes)
FROM read_parquet('{TEST_DIR}/output/*.parquet') ORDER BY id;
----
1	Alice	true	00FF0102
2	NULL	true	(empty)
3	Charlie	true	NULL
4	appended	true	NULL

statement ok
COPY (SELECT 1 AS id WHERE false) TO '{TEST_DIR}/empty' (FORMAT duckport_parquet);

query I
SELECT count(*) FROM read_parquet('{TEST_DIR}/empty/*.parquet');
----
0

# Check the published file codecs as well as independent-reader round trips.
statement ok
COPY (
    SELECT 'z' AS zstd, 's' AS snappy, 'g' AS gzip, 'l' AS lz4, 'u' AS plain
) TO '{TEST_DIR}/codecs' (
    FORMAT duckport_parquet,
    COLUMN_COMPRESSION {'zstd': 'zstd', 'snappy': 'snappy', 'gzip': 'gzip', 'lz4': 'lz4', 'plain': 'uncompressed'}
);

query TT rowsort
SELECT path_in_schema, compression FROM parquet_metadata('{TEST_DIR}/codecs/*.parquet');
----
gzip	GZIP
lz4	LZ4_RAW
plain	UNCOMPRESSED
snappy	SNAPPY
zstd	ZSTD

query T
SELECT zstd || snappy || gzip || lz4 || plain FROM read_parquet('{TEST_DIR}/codecs/*.parquet');
----
zsglu
