# name: test/sql/writers/atif_media.test
# description: ATIF media defaults and metadata survive DuckDB tables and COPY without BLOB_COLUMNS
# group: [sql]

require duckport

statement ok
CREATE TABLE atif_media AS SELECT trajectory_id, steps AS renamed_steps FROM duckport_scan_atif('testdata/atif/trajectory_media.json');

statement ok
COPY atif_media TO '{TEST_DIR}/atif_media.lance' (FORMAT duckport_lance);

# Explicit nested text compression overrides the ATIF lz4 default.
statement ok
COPY atif_media TO '{TEST_DIR}/atif_media_zstd.lance' (FORMAT duckport_lance, COLUMN_COMPRESSION {'renamed_steps.message.text': 'zstd'});

# Force each layout through SQL's FFI options, with both media fields selected automatically.
statement ok
COPY atif_media TO '{TEST_DIR}/atif_inline.lance' (FORMAT duckport_lance, BLOB_INLINE_SIZE_THRESHOLD 8192, BLOB_DEDICATED_SIZE_THRESHOLD 16384);

statement ok
COPY atif_media TO '{TEST_DIR}/atif_packed.lance' (FORMAT duckport_lance, BLOB_INLINE_SIZE_THRESHOLD 0, BLOB_DEDICATED_SIZE_THRESHOLD 8192);

statement ok
COPY atif_media TO '{TEST_DIR}/atif_dedicated.lance' (FORMAT duckport_lance, BLOB_INLINE_SIZE_THRESHOLD 0, BLOB_DEDICATED_SIZE_THRESHOLD 1);

restart no_extension_load

statement ok
LOAD '{BUILD_DIRECTORY}/extension/lance/lance.duckdb_extension';

query TIII
SELECT trajectory_id,
       renamed_steps[1].message[2].source.path = (SELECT content FROM read_blob('testdata/atif/atif-image.png')),
       renamed_steps[1].message[3].source.path = (SELECT content FROM read_blob('testdata/atif/atif-audio.wav')),
       renamed_steps[2].observation.results[1].content[3].source.path = renamed_steps[1].message[3].source.path
FROM '{TEST_DIR}/atif_media.lance';
----
media	true	true	true

query T
SELECT decode(renamed_steps[1].message[1].text) FROM '{TEST_DIR}/atif_media_zstd.lance';
----
hello 你好🙂

query TII rowsort
SELECT 'inline',
       renamed_steps[1].message[2].source.path = (SELECT content FROM read_blob('testdata/atif/atif-image.png')),
       renamed_steps[2].observation.results[1].content[3].source.path = (SELECT content FROM read_blob('testdata/atif/atif-audio.wav'))
FROM '{TEST_DIR}/atif_inline.lance'
UNION ALL
SELECT 'packed',
       renamed_steps[1].message[2].source.path = (SELECT content FROM read_blob('testdata/atif/atif-image.png')),
       renamed_steps[2].observation.results[1].content[3].source.path = (SELECT content FROM read_blob('testdata/atif/atif-audio.wav'))
FROM '{TEST_DIR}/atif_packed.lance'
UNION ALL
SELECT 'dedicated',
       renamed_steps[1].message[2].source.path = (SELECT content FROM read_blob('testdata/atif/atif-image.png')),
       renamed_steps[2].observation.results[1].content[3].source.path = (SELECT content FROM read_blob('testdata/atif/atif-audio.wav'))
FROM '{TEST_DIR}/atif_dedicated.lance';
----
dedicated	true	true
inline	true	true
packed	true	true
