# name: test/sql/writers/lance_lifecycle.test
# description: Create, append, overwrite, empty commit and failed writes retain committed Lance rows
# group: [sql]

require duckport

statement ok
COPY (SELECT 1::INTEGER id, '你好' name) TO '{TEST_DIR}/append.lance' (FORMAT duckport_lance);

statement error
COPY (SELECT 9::INTEGER id, 'must not replace' name) TO '{TEST_DIR}/append.lance' (FORMAT duckport_lance);

statement error
COPY (SELECT 'wrong-type' id, 'must not append' name) TO '{TEST_DIR}/append.lance' (FORMAT duckport_lance, APPEND);

statement ok
COPY (SELECT 2::INTEGER id, NULL::VARCHAR name) TO '{TEST_DIR}/append.lance' (FORMAT duckport_lance, APPEND);

statement ok
COPY (SELECT 1::INTEGER id, 'old' name) TO '{TEST_DIR}/overwrite.lance' (FORMAT duckport_lance);

statement ok
COPY (SELECT 3::INTEGER id, 'Δuck🙂' name) TO '{TEST_DIR}/overwrite.lance' (FORMAT duckport_lance, OVERWRITE);

statement ok
COPY (SELECT 1::INTEGER id WHERE false) TO '{TEST_DIR}/empty.lance' (FORMAT duckport_lance);

statement error
COPY (SELECT 'file://{TEST_DIR}/absent.bin' payload) TO '{TEST_DIR}/failed.lance'
(FORMAT duckport_lance, BLOB_COLUMNS ('payload'));

query I
SELECT count(*) FROM glob('{TEST_DIR}/failed.lance/_versions/*.manifest');
----
0

restart no_extension_load

statement ok
LOAD '{BUILD_DIRECTORY}/extension/lance/lance.duckdb_extension';

query IT rowsort
SELECT id, name FROM '{TEST_DIR}/append.lance';
----
1	你好
2	NULL

query IT
SELECT id, name FROM '{TEST_DIR}/overwrite.lance';
----
3	Δuck🙂

query I
SELECT count(*) FROM '{TEST_DIR}/empty.lance';
----
0
