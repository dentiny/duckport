# name: test/sql/writers/lance_sizes.test
# description: Lance COPY byte-size options and bind-time validation
# group: [sql]

require duckport

statement ok
COPY (SELECT 'file://{WORKING_DIRECTORY}/testdata/zenodo/attachment.bin' AS payload)
TO '{TEST_DIR}/sizes.lance' (FORMAT duckport_lance, BLOB_COLUMNS ('payload'),
    BLOB_INLINE_SIZE_THRESHOLD 0, BLOB_DEDICATED_SIZE_THRESHOLD 1, TARGET_FILE_SIZE 1);

statement ok
COPY (SELECT 'file://{WORKING_DIRECTORY}/testdata/zenodo/attachment.bin' AS payload)
TO '{TEST_DIR}/sizes.lance' (FORMAT duckport_lance, BLOB_COLUMNS ('payload'), APPEND,
    BLOB_INLINE_SIZE_THRESHOLD 0, BLOB_DEDICATED_SIZE_THRESHOLD 1, TARGET_FILE_SIZE 1);

# Keep names lowercase to match the binder's error messages.
foreach option blob_inline_size_threshold blob_dedicated_size_threshold

foreach value -1 NULL 1.5 9223372036854775808 true '1024'

statement error
COPY (SELECT 1 AS id) TO '{TEST_DIR}/invalid.lance' (FORMAT duckport_lance, ${option} ${value});
----
${option}

endloop

statement error
COPY (SELECT 1 AS id) TO '{TEST_DIR}/invalid.lance' (FORMAT duckport_lance, ${option});
----
${option}

foreach format duckport_parquet duckport_iceberg

statement error
COPY (SELECT 1 AS id) TO '{TEST_DIR}/invalid' (FORMAT ${format}, ${option} 1);
----
Unrecognized option

endloop

endloop

foreach option blob_dedicated_size_threshold

statement error
COPY (SELECT 1 AS id) TO '{TEST_DIR}/invalid.lance' (FORMAT duckport_lance, ${option} 0);
----
${option}

endloop

restart no_extension_load

statement ok
LOAD '{BUILD_DIRECTORY}/extension/lance/lance.duckdb_extension';

query I
SELECT count(*) FROM '{TEST_DIR}/sizes.lance'
WHERE payload = (SELECT content FROM read_blob('testdata/zenodo/attachment.bin'));
----
2
