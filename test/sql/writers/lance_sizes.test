# name: test/sql/writers/lance_sizes.test
# description: Lance COPY byte-size options and bind-time validation
# group: [sql]

require duckport

statement ok
COPY (SELECT 'file://{WORKING_DIRECTORY}/testdata/zenodo/attachment.bin' AS payload)
TO '{TEST_DIR}/sizes.lance' (FORMAT duckport_lance, BLOB_COLUMNS ('payload'),
    BLOB_INLINE_SIZE_THRESHOLD 0, BLOB_DEDICATED_SIZE_THRESHOLD 1, TARGET_FILE_SIZE 1);

statement ok
COPY (SELECT 'file://{WORKING_DIRECTORY}/testdata/zenodo/attachment.bin' AS payload)
TO '{TEST_DIR}/sizes.lance' (FORMAT duckport_lance, BLOB_COLUMNS ('payload'), APPEND,
    BLOB_INLINE_SIZE_THRESHOLD 0, BLOB_DEDICATED_SIZE_THRESHOLD 1, TARGET_FILE_SIZE 1);

statement error
COPY (SELECT 1 AS id) TO '{TEST_DIR}/invalid.lance' (FORMAT duckport_lance, BLOB_INLINE_SIZE_THRESHOLD -1);
