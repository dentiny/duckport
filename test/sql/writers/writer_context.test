# name: test/sql/writers/writer_context.test
# description: Writer runtime credentials are isolated from COPY options and refreshed at execution
# group: [sql]

require duckport

require duckport_test_fixture

require parquet

set ignore_error_messages

# This secret cannot be captured as Blob credentials. Plain writers must never
# inspect it, even when another HTTP credential exists in the session.

statement ok
CREATE SECRET unused_http (TYPE http, EXTRA_HTTP_HEADERS MAP {'X-Unused': NULL}, SCOPE 'http://unused.invalid/');

query I
COPY (SELECT 1 AS id) TO '{TEST_DIR}/plain.parquet' (FORMAT duckport_parquet);
----
1

query I
SELECT id FROM read_parquet('{TEST_DIR}/plain.parquet/*.parquet');
----
1

query I
COPY (SELECT 2 AS id) TO '{TEST_DIR}/plain.lance' (FORMAT duckport_lance);
----
1

# Backends without Blob downloads reach their own validation without capturing sources.

statement error
COPY (SELECT 3 AS id) TO 'tests.people' (FORMAT duckport_iceberg, APPEND,
    STORAGE_ROOT '{TEST_DIR}/context_iceberg');
----
Iceberg COPY requires CATALOG_URI and STORAGE_ROOT

statement ok
DROP SECRET unused_http;

# PREPARE has no credentials. Each EXECUTE opens a new writer against the
# current secret state, including rotation and removal of the source secret.

statement ok
SET VARIABLE context_endpoint = duckport_fixture('blob_http', 'start_anonymous');

statement ok
PREPARE context_copy AS COPY (SELECT getvariable('context_endpoint') || '/private/a.bin' AS payload)
TO '{TEST_DIR}/prepared.lance' (FORMAT duckport_lance, OVERWRITE, BLOB_COLUMNS ('payload'));

statement ok
CREATE SECRET context_http (TYPE http, BEARER_TOKEN 'fixture-key', SCOPE getvariable('context_endpoint') || '/private/');

query I
EXECUTE context_copy;
----
1

statement ok
CREATE OR REPLACE SECRET context_http (TYPE http, BEARER_TOKEN 'wrong-key', SCOPE getvariable('context_endpoint') || '/private/');

statement error
EXECUTE context_copy;
----
DuckPort

statement ok
CREATE OR REPLACE SECRET context_http (TYPE http, BEARER_TOKEN 'fixture-key', SCOPE getvariable('context_endpoint') || '/private/');

query I
EXECUTE context_copy;
----
1

statement ok
DROP SECRET context_http;

statement error
EXECUTE context_copy;
----
DuckPort

statement ok
DEALLOCATE context_copy;

query T
SELECT duckport_fixture('blob_http', 'stop');
----
stopped

restart no_extension_load

statement ok
LOAD '{BUILD_DIRECTORY}/extension/lance/lance.duckdb_extension';

query I
SELECT id FROM '{TEST_DIR}/plain.lance';
----
2

query II
SELECT count(*), count(*) FILTER (WHERE payload = (SELECT content FROM read_blob('testdata/blob_http/payload.bin')))
FROM '{TEST_DIR}/prepared.lance';
----
1	1
