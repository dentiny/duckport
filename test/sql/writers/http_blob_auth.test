# name: test/sql/writers/http_blob_auth.test
# description: COPY Blob downloads use scoped HTTP credentials and preserve payload bytes
# group: [sql]

require duckport

require duckport_test_fixture

statement ok
SET VARIABLE blob_endpoint = duckport_fixture('blob_http', 'start_anonymous');

statement error
COPY (SELECT getvariable('blob_endpoint') || '/private/a.bin' AS payload)
TO '{TEST_DIR}/unauthenticated.lance' (FORMAT duckport_lance, BLOB_COLUMNS ('payload'));
----
DuckPort

statement ok
CREATE SECRET blob_http_token (TYPE http, BEARER_TOKEN 'fixture-key', SCOPE getvariable('blob_endpoint') || '/private/');

statement ok
CREATE SECRET blob_custom_header (TYPE http, EXTRA_HTTP_HEADERS MAP {'X-API-Key':'fixture-custom'}, SCOPE getvariable('blob_endpoint') || '/api-key/');

query I
COPY (SELECT getvariable('blob_endpoint') || path AS payload FROM (VALUES
    ('/private/a.bin'), ('/api-key/c.bin')) t(path))
TO '{TEST_DIR}/authenticated.lance' (FORMAT duckport_lance, BLOB_COLUMNS ('payload'));
----
2

statement ok
DROP SECRET blob_http_token;

statement ok
DROP SECRET blob_custom_header;

query T
SELECT duckport_fixture('blob_http', 'stop');
----
stopped

restart no_extension_load

statement ok
LOAD '{BUILD_DIRECTORY}/extension/lance/lance.duckdb_extension';

query II
SELECT count(*), count(*) FILTER (WHERE payload = (SELECT content FROM read_blob('testdata/blob_http/payload.bin')))
FROM '{TEST_DIR}/authenticated.lance';
----
2	2
