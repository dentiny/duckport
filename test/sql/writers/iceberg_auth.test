# name: test/sql/writers/iceberg_auth.test
# description: Catalog and data storage credentials are independent
# group: [sql]

require duckport

require duckport_test_fixture

statement ok
SET VARIABLE auth_catalog = duckport_iceberg_fixture('{TEST_DIR}/auth_warehouse', 'start_authenticated');

statement ok
CREATE SECRET wrong_catalog_token (TYPE http, BEARER_TOKEN 'wrong', SCOPE getvariable('auth_catalog') || '/other');

statement error
COPY (SELECT 1 AS id, 'missing-token' AS name) TO 'tests.people' (FORMAT duckport_iceberg,
    CATALOG_URI getvariable('auth_catalog'), STORAGE_ROOT '{TEST_DIR}/auth_warehouse', APPEND);
----
401

statement ok
CREATE SECRET catalog_token (TYPE http, BEARER_TOKEN 'fixture-catalog-key', SCOPE getvariable('auth_catalog'));

statement ok
COPY (SELECT 1 AS id, 'authenticated' AS name) TO 'tests.people' (FORMAT duckport_iceberg,
    CATALOG_URI getvariable('auth_catalog'), STORAGE_ROOT '{TEST_DIR}/auth_warehouse', APPEND);

statement ok
COPY (SELECT 2 AS id, 'commit-token' AS name) TO 'tests.people' (FORMAT duckport_iceberg,
    CATALOG_URI getvariable('auth_catalog'), STORAGE_ROOT '{TEST_DIR}/auth_warehouse', APPEND);

statement ok
CREATE OR REPLACE SECRET catalog_token (TYPE http, BEARER_TOKEN '', SCOPE getvariable('auth_catalog'));

statement error
COPY (SELECT 3 AS id, 'empty-token' AS name) TO 'tests.people' (FORMAT duckport_iceberg,
    CATALOG_URI getvariable('auth_catalog'), STORAGE_ROOT '{TEST_DIR}/auth_warehouse', APPEND);
----
BEARER_TOKEN must not be empty

statement ok
DROP SECRET catalog_token;

statement ok
DROP SECRET wrong_catalog_token;

query T
SELECT duckport_iceberg_fixture('{TEST_DIR}/auth_warehouse', 'stop');
----
stopped
