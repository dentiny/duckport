# name: test/sql/writers/nested_blobs.test
# description: BLOB_COLUMNS selects nested text URLs through lists
# group: [sql]

require duckport

query I
COPY (
    SELECT [{'path': 'file://{WORKING_DIRECTORY}/testdata/zenodo/attachment.bin'}, NULL] AS media
) TO '{TEST_DIR}/nested.lance' (FORMAT duckport_lance, BLOB_COLUMNS ('MEDIA.PATH'));
----
1
