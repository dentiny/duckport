# name: test/sql/readers/arxiv_metadata_auth.test
# description: Scoped bearer authentication for custom arXiv metadata endpoints
# group: [sql]

require duckport
require duckport_test_fixture

statement ok
SET VARIABLE arxiv_metadata_endpoint = duckport_fixture('arxiv_metadata', 'start_authenticated');

statement ok
SET VARIABLE arxiv_metadata_scope = getvariable('arxiv_metadata_endpoint') || '/';

statement ok
CREATE SECRET arxiv_metadata_test (TYPE http, BEARER_TOKEN 'fixture-key', SCOPE getvariable('arxiv_metadata_scope'));

query I
SELECT count(*) FROM duckport_scan_arxiv_metadata('records', endpoint := getvariable('arxiv_metadata_endpoint'));
----
2

query T
SELECT count(*) > 0 AND bool_and(has_authorization AND "authorization" = 'Bearer fixture-key') FROM duckport_fixture_requests('arxiv_metadata');
----
true

statement ok
DROP SECRET arxiv_metadata_test;

query T
SELECT duckport_fixture('arxiv_metadata', 'stop');
----
stopped
