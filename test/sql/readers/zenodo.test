require duckport

statement error
SELECT * FROM duckport_scan_zenodo('test');
----
file_name is required

statement error
SELECT * FROM duckport_scan_zenodo(NULL);
----
NULL

statement error
SELECT * FROM duckport_scan_zenodo('test', file_name := NULL);
----
NULL
