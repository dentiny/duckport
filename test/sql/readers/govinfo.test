require duckport

statement error
SELECT * FROM duckport_scan_govinfo('test');
----
file_name is required

statement error
SELECT * FROM duckport_scan_govinfo(NULL);
----
NULL

statement error
SELECT * FROM duckport_scan_govinfo('test', file_name := NULL);
----
NULL
