# name: test/sql/readers/json_metrics.test
# description: Zero-column JSON scans report live progress, encoded I/O and EOF metrics
# group: [sql]

require duckport
require duckport_test_fixture
require json

# Keep input larger than inference/read-ahead buffers, without committing a large fixture.
statement ok
SET VARIABLE json_metrics_input = repeat('{"id":1,"text":"' || repeat('x', 128) || '"}' || chr(10), 20000);

statement ok
SELECT duckport_fixture_write('{TEST_DIR}/metrics.jsonl', encode(getvariable('json_metrics_input')));

statement ok
CREATE TABLE json_scan_metrics AS
SELECT duckport_fixture_json_metrics('{TEST_DIR}/metrics.jsonl')::JSON AS metrics;

# COUNT(*)'s zero-column projection still carries all rows through the Arrow FFI.
query II
SELECT (metrics->>'columns')::BIGINT, (metrics->>'rows')::BIGINT FROM json_scan_metrics;
----
0	20000

# The first batch is not EOF, and progress uses the encoded file size.
query IIII
SELECT (metrics->>'$.initial.total_bytes_known')::BOOLEAN,
       (metrics->>'$.initial.total_bytes')::BIGINT = octet_length(encode(getvariable('json_metrics_input'))),
       (metrics->>'$.initial.progress_bytes')::BIGINT > 0 AND
           (metrics->>'$.initial.progress_bytes')::BIGINT < (metrics->>'$.initial.total_bytes')::BIGINT,
       (metrics->>'$.initial.finished')::BOOLEAN
FROM json_scan_metrics;
----
true	true	true	false

query III
SELECT (metrics->>'$.complete.finished')::BOOLEAN,
       (metrics->>'$.complete.rows_read')::BIGINT,
       (metrics->>'$.complete.bytes_read')::BIGINT >= (metrics->>'$.complete.total_bytes')::BIGINT
FROM json_scan_metrics;
----
true	20000	true
