# name: test/sql/readers/arxiv.test
# description: Read arxiv through its native service accessor
# group: [sql]

require duckport

query II
SELECT count(*), sum(octet_length(data)) FROM duckport_scan_arxiv('testdata/arxiv', kind := 'source', month := '2410', batch_size := 1, read_concurrency := 2);
----
2	25

query I
SELECT count(*) FROM duckport_scan_arxiv('testdata/arxiv', kind := 'source', month := '2501');
----
0

# Bulk content expands packages, excludes attachments and retains both article IDs.
query IIIT
SELECT count(*), count(DISTINCT article_id), count(DISTINCT source_index), bool_and(format = 'latex' AND data_type = 'latex' AND NOT starts_with(decode(source_name), 'anc/') AND octet_length(data) > 0) FROM duckport_scan_arxiv('testdata/arxiv', format := 'latex', shard := 'latex.tar', batch_size := 1, read_concurrency := 2);
----
4	2	2	true

query TTTTTTTTT
SELECT typeof(article_id), typeof(format), typeof(shard_uri), typeof(entry_index), typeof(entry_name), typeof(source_index), typeof(source_name), typeof(data), typeof(data_type) FROM duckport_scan_arxiv('testdata/arxiv', format := 'latex', shard := 'latex.tar') LIMIT 1;
----
VARCHAR	VARCHAR	VARCHAR	UBIGINT	BLOB	UBIGINT	BLOB	BLOB	VARCHAR

# Explicit article selection uses website-style routes and preserves original bytes.
query TTTT
SELECT article_id, format, source_uri, starts_with(decode(data), '%PDF') FROM duckport_scan_arxiv('testdata/arxiv/articles', article_id := '2410.00001v2', format := 'pdf');
----
2410.00001v2	pdf	pdf/2410.00001v2	true

query TTT
SELECT format, source_uri, contains(decode(data), '<html>') FROM duckport_scan_arxiv('testdata/arxiv/articles', article_id := '2410.00001v2', format := 'html', read_concurrency := 2);
----
html	html/2410.00001v2	true

query TTT
SELECT format, source_uri, contains(decode(data), 'documentclass') FROM duckport_scan_arxiv('testdata/arxiv/articles', article_id := '2410.00001v2', format := 'latex');
----
latex	src/2410.00001v2	true

statement error
SELECT * FROM duckport_scan_arxiv('testdata/arxiv', format := 'html');
----
format=html requires article_id

statement error
SELECT * FROM duckport_scan_arxiv('testdata/arxiv', format := 'text');
----
format must be pdf, latex, xml, or html

statement error
SELECT * FROM duckport_scan_arxiv('testdata/arxiv', format := 'latex', shard := 'latex.tar', month := '2410');
----
shard cannot be combined with month or article_id

statement error
SELECT * FROM duckport_scan_arxiv('testdata/arxiv', format := 'xml');
----
format=xml requires a caller-supplied shard

statement error
SELECT * FROM duckport_scan_arxiv('testdata/arxiv', format := 'latex', shard := 'latex.tar', metadata_uri := 'missing.parquet');
----
bulk format output has a fixed schema

statement error
SELECT * FROM duckport_scan_arxiv('testdata/arxiv', format := 'pdf', kind := 'source');
----
format and kind cannot be combined

statement error
SELECT * FROM duckport_scan_arxiv('testdata/arxiv/articles', article_id := '2410.00001v2');
----
article_id requires format

statement error
SELECT * FROM duckport_scan_arxiv('testdata/arxiv/articles', article_id := '2410.00001v2', format := 'pdf', month := '2410');
----
article_id cannot be combined

statement error
SELECT * FROM duckport_scan_arxiv('testdata/arxiv/articles', article_id := '../escape', format := 'pdf');
----
expected modern arXiv article ID

# Original payload bytes survive the reader and C ABI unchanged.
query T
SELECT data = content FROM duckport_scan_arxiv('testdata/arxiv/articles', article_id := '2410.00001v2', format := 'pdf'), read_blob('testdata/arxiv/articles/pdf/2410.00001v2');
----
true

# A missing selected representation does not fall back to an existing PDF.
query T
SELECT starts_with(decode(data), '%PDF') FROM duckport_scan_arxiv('testdata/arxiv/articles', article_id := '2410.00002v1', format := 'pdf');
----
true

# Match the selected object; access 0.14 keeps NotFound in the structured error kind.
statement error
SELECT * FROM duckport_scan_arxiv('testdata/arxiv/articles', article_id := '2410.00002v1', format := 'html');
----
object "html/2410.00002v1"

# Format keywords are ASCII case-insensitive in both bulk and article mode.
query I
SELECT count(*) FROM duckport_scan_arxiv('testdata/arxiv', format := 'LaTeX', shard := 'latex.tar');
----
4

query T
SELECT format FROM duckport_scan_arxiv('testdata/arxiv/articles', article_id := '2410.00001v2', format := 'PDF');
----
pdf

query T
SELECT format FROM duckport_scan_arxiv('testdata/arxiv/articles', article_id := '2410.00001v2', format := 'HtMl');
----
html

query II
SELECT count(*), sum(octet_length(data)) FROM duckport_scan_arxiv('testdata/arxiv', kind := 'SoUrCe', month := '2410');
----
2	25
