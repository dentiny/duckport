# name: test/sql/readers/arxiv.test
# description: Read arxiv through its native service accessor
# group: [sql]

require duckport

query II
SELECT count(*), sum(octet_length(data)) FROM duckport_scan_arxiv('testdata/arxiv', kind := 'source', month := '2410', batch_size := 1);
----
2	25

query I
SELECT count(*) FROM duckport_scan_arxiv('testdata/arxiv', kind := 'source', month := '2501');
----
0

# Discovery includes both available distributions; the default remains source-only.
query II
SELECT count(*), sum(octet_length(data)) FROM duckport_scan_arxiv('testdata/arxiv', kind := 'auto', month := '2410');
----
4	46

query I
SELECT count(*) FROM duckport_scan_arxiv('testdata/arxiv', month := '2410');
----
2
