# name: test/sql/readers/atif_http.test
# description: Authenticated ATIF media is copied into Lance and survives server shutdown
# group: [sql]

require duckport

require duckport_test_fixture

statement ok
SET VARIABLE atif_endpoint = duckport_fixture('atif', 'start_authenticated');

statement ok
SET VARIABLE atif_scope = duckport_fixture('atif', 'scope');

statement ok
CREATE SECRET atif_http IN connection (TYPE http, BEARER_TOKEN 'fixture-key', SCOPE getvariable('atif_scope'));

statement ok
COPY (SELECT * FROM duckport_scan_atif(getvariable('atif_endpoint') || '/runs/trajectory_media.json'))
TO '{TEST_DIR}/remote.lance' (FORMAT duckport_lance);

statement ok
SELECT duckport_fixture('atif', 'stop');

restart no_extension_load

statement ok
LOAD '{BUILD_DIRECTORY}/extension/lance/lance.duckdb_extension';

query II
SELECT steps[1].message[2].source.path = (SELECT content FROM read_blob('testdata/atif/atif-image.png')),
       steps[1].message[3].source.path = (SELECT content FROM read_blob('testdata/atif/atif-audio.wav'))
FROM '{TEST_DIR}/remote.lance';
----
true	true
