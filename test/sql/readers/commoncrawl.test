# name: test/sql/readers/commoncrawl.test
# description: Read a whole Common Crawl dataset or one exact segment
# group: [sql]

require duckport

query TT
SELECT id, decode(body) FROM duckport_scan_warc('testdata/commoncrawl/crawl-data/CC-MAIN-2022-40/segments/1664030338280.51/warc/z.warc.gz');
----
<urn:test:a>	123

query TT rowsort
SELECT id, type FROM duckport_scan_commoncrawl('testdata/commoncrawl/crawl-data/CC-MAIN-2022-40/', batch_size := 1);
----
<urn:test:a>	resource
<urn:test:a>	resource
<urn:test:b>	resource
<urn:test:one>	metadata

query TT rowsort
SELECT id, type FROM duckport_scan_commoncrawl_segment('testdata/commoncrawl/crawl-data/CC-MAIN-2022-40/segments/1664030338280.51/', batch_size := 2);
----
<urn:test:a>	resource
<urn:test:a>	resource
<urn:test:b>	resource

query TT
SELECT id, type FROM duckport_scan_commoncrawl_segment('testdata/commoncrawl/crawl-data/CC-MAIN-2022-40/segments/1664030338280.510/');
----
<urn:test:one>	metadata

statement error
SELECT * FROM duckport_scan_commoncrawl_segment('testdata/commoncrawl/crawl-data/CC-MAIN-2022-40/segments/1664030338280.52/');
