# name: test/sql/readers/openstax.test
# description: Validate openstax attachment selection before network I/O
# group: [sql]

require duckport

statement error
SELECT * FROM duckport_scan_openstax('test');
----
file_name is required

statement error
SELECT * FROM duckport_scan_openstax(NULL);
----
NULL

statement error
SELECT * FROM duckport_scan_openstax('test', file_name := NULL);
----
NULL
