# name: test/sql/readers/internet_archive.test
# description: Validate internet_archive attachment selection before network I/O
# group: [sql]

require duckport

statement error
SELECT * FROM duckport_scan_internet_archive('test');
----
file_name is required

statement error
SELECT * FROM duckport_scan_internet_archive(NULL);
----
NULL

statement error
SELECT * FROM duckport_scan_internet_archive('test', file_name := NULL);
----
NULL
