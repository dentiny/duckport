require duckport

statement error
SELECT * FROM duckport_scan_biorxiv('test');
----
file_name is required

statement error
SELECT * FROM duckport_scan_biorxiv(NULL);
----
NULL

statement error
SELECT * FROM duckport_scan_biorxiv('test', file_name := NULL);
----
NULL
