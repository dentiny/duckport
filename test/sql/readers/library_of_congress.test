# name: test/sql/readers/library_of_congress.test
# description: Validate library_of_congress attachment selection before network I/O
# group: [sql]

require duckport

statement error
SELECT * FROM duckport_scan_library_of_congress('test');
----
file_name is required

statement error
SELECT * FROM duckport_scan_library_of_congress(NULL);
----
NULL

statement error
SELECT * FROM duckport_scan_library_of_congress('test', file_name := NULL);
----
NULL
