# name: test/sql/readers/federal_register_http.test
# description: Native loopback HTTP coverage for federal_register
# group: [sql]

require duckport

require duckport_test_fixture

set ignore_error_messages

# Anonymous provider requests and attachment reads.

statement ok
SET VARIABLE fixture_endpoint = duckport_fixture('federal_register', 'start_anonymous');

# Adapted from open-arrow-access-service 0.1.0 provider fixture tests.
# Binary preserves original bytes independently of filename extensions.

query I
SELECT octet_length(data) FROM duckport_scan_federal_register('2026-22789', file_name := 'pdf_url', endpoint := getvariable('fixture_endpoint'));
----
23

# Each prepared execution obtains an independent reader of the selected attachment.

statement ok
PREPARE provider_scan AS SELECT octet_length(data) FROM duckport_scan_federal_register('2026-22789', file_name := 'pdf_url', endpoint := getvariable('fixture_endpoint'));

query I
EXECUTE provider_scan;
----
23

query I
EXECUTE provider_scan;
----
23

query IT rowsort
SELECT id, name FROM duckport_scan_federal_register('2026-22789', file_name := 'pdf_url', endpoint := getvariable('fixture_endpoint'), format := 'csv', batch_size := 1);
----
1	alpha
2	beta

statement error
SELECT * FROM duckport_scan_federal_register('2026-22789', file_name := 'missing-file', endpoint := getvariable('fixture_endpoint'));
----
filename is absent from manifest

statement error
SELECT * FROM duckport_scan_federal_register('2026-22789', file_name := 'pdf_url', endpoint := getvariable('fixture_endpoint'), format := 'invalid');
----
format must be

statement error
SELECT * FROM duckport_scan_federal_register('2026-22789', file_name := 'pdf_url', endpoint := getvariable('fixture_endpoint'), format := 'XmL');
----
record_path is required

statement ok
DEALLOCATE provider_scan;

# Malformed metadata must fail without reading any attachment bytes.

statement ok
SET VARIABLE fixture_downloads_before = (SELECT count(*) FROM duckport_fixture_requests('federal_register') WHERE is_download);

statement ok
SET VARIABLE fixture_requests_before = (SELECT count(*) FROM duckport_fixture_requests('federal_register') WHERE origin = 'api');

query T
SELECT duckport_fixture('federal_register', 'reject_metadata');
----
ok

# Invalid provider metadata must fail before downloading content.

statement error
SELECT octet_length(data) FROM duckport_scan_federal_register('2026-22789', file_name := 'pdf_url', endpoint := getvariable('fixture_endpoint'));
----
DuckPort

query T
SELECT count(*) = getvariable('fixture_downloads_before') FROM duckport_fixture_requests('federal_register') WHERE is_download;
----
true

query T
SELECT count(*) > getvariable('fixture_requests_before') FROM duckport_fixture_requests('federal_register') WHERE origin = 'api';
----
true

# Inspect the actual captured HTTP requests through native SQL.

query T
SELECT count(*) > 0 FROM duckport_fixture_requests('federal_register') WHERE origin = 'api';
----
true

query T
SELECT count(*) > 0 FROM duckport_fixture_requests('federal_register') WHERE origin = 'download';
----
true

query T
SELECT count(*) > 0 FROM duckport_fixture_requests('federal_register') WHERE is_download;
----
true

query T
SELECT count(*) = 0 FROM duckport_fixture_requests('federal_register') WHERE origin = 'api' AND has_authorization;
----
true

query T
SELECT count(*) = 0 FROM duckport_fixture_requests('federal_register') WHERE origin = 'download' AND (has_authorization OR contains(headers, 'fixture-key') OR contains(target, 'fixture-key'));
----
true

query T
SELECT duckport_fixture('federal_register', 'stop');
----
stopped
