# name: test/sql/readers/arxiv_snapshot_auth.test
# description: Metadata snapshots use their own region, source keys and requester-pays policy
# group: [sql]

require duckport

require duckport_test_fixture

require httpfs

set ignore_error_messages

statement ok
SET VARIABLE arxiv_snapshot_endpoint = duckport_fixture('arxiv', 'start_anonymous');

statement ok
CREATE SECRET pdf_source (TYPE s3, KEY_ID 'pdf-key', SECRET 'pdf-secret', REGION 'us-east-1',
    ENDPOINT getvariable('arxiv_snapshot_endpoint'), URL_STYLE 'path', USE_SSL false, SCOPE 's3://arxiv-test/');

statement ok
CREATE SECRET metadata_source (TYPE s3, KEY_ID 'snapshot-key', SECRET 'snapshot-secret',
    SESSION_TOKEN 'snapshot-session', REGION 'eu-west-1', ENDPOINT getvariable('arxiv_snapshot_endpoint'),
    URL_STYLE 'path', USE_SSL false, SCOPE 's3://arxiv-metadata/');

query II
SELECT count(*), sum(octet_length(data))
FROM duckport_scan_arxiv('s3://arxiv-test/', kind := 'pdf', requester_pays := true,
    metadata_uri := 's3://arxiv-metadata/2410.parquet');
----
2	21

query TTTT
SELECT count(*) > 0, bool_and(contains("authorization", 'Credential=snapshot-key/')),
       bool_and(contains("authorization", '/eu-west-1/s3/aws4_request')), bool_and(NOT has_request_payer)
FROM duckport_fixture_requests('arxiv') WHERE starts_with(target, '/arxiv-metadata/');
----
true	true	true	true

query TTTT
SELECT count(*) > 0, bool_and(contains("authorization", 'Credential=pdf-key/')),
       bool_and(contains("authorization", '/us-east-1/s3/aws4_request')),
       bool_and(has_request_payer AND request_payer = 'requester')
FROM duckport_fixture_requests('arxiv') WHERE starts_with(target, '/arxiv-test/');
----
true	true	true	true

# An HTTPS/HTTP snapshot has its own HTTP secret, even when PDFs come from local storage.
statement ok
CREATE SECRET metadata_http (TYPE http, BEARER_TOKEN 'snapshot-http',
    SCOPE getvariable('arxiv_snapshot_endpoint'));

query I
SELECT count(*) FROM duckport_scan_arxiv('testdata/arxiv', kind := 'pdf',
    metadata_uri := getvariable('arxiv_snapshot_endpoint') || '/snapshot.parquet');
----
2

statement ok
DROP SECRET metadata_http;

statement ok
DROP SECRET metadata_source;

statement ok
DROP SECRET pdf_source;

query T
SELECT duckport_fixture('arxiv', 'stop');
----
stopped
