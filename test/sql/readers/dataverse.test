# name: test/sql/readers/dataverse.test
# description: Validate dataverse attachment selection before network I/O
# group: [sql]

require duckport

statement error
SELECT * FROM duckport_scan_dataverse('test');
----
file_name is required

statement error
SELECT * FROM duckport_scan_dataverse(NULL);
----
NULL

statement error
SELECT * FROM duckport_scan_dataverse('test', file_name := NULL);
----
NULL
