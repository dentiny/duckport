# name: test/sql/readers/bhl.test
# description: Validate bhl attachment selection before network I/O
# group: [sql]

require duckport

statement error
SELECT * FROM duckport_scan_bhl('test');
----
file_name is required

statement error
SELECT * FROM duckport_scan_bhl(NULL);
----
NULL

statement error
SELECT * FROM duckport_scan_bhl('test', file_name := NULL);
----
NULL
