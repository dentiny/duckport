# name: test/sql/readers/parquet.test
# description: Read Parquet through open-arrow-access
# group: [sql]
require duckport

query IT rowsort
SELECT id, name FROM duckport_scan_parquet('test/data/people.parquet', batch_size := 2);
----
1	Alice
2	NULL
3	Charlie

statement ok
PREPARE parquet_scan AS SELECT count(*) FROM duckport_scan_parquet('test/data/people.parquet');

query I
EXECUTE parquet_scan;
----
3

query I
EXECUTE parquet_scan;
----
3

statement error
SELECT * FROM duckport_scan_parquet('test/data/people.parquet', batch_size := 0);
----
batch_size
