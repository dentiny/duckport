# name: test/sql/readers/openstax_http.test
# description: Native loopback HTTP coverage for openstax
# group: [sql]

require duckport

require duckport_test_fixture

set ignore_error_messages

# Anonymous provider requests and attachment reads.

statement ok
SET VARIABLE fixture_endpoint = duckport_fixture('openstax', 'start_anonymous');

statement ok
SET VARIABLE fixture_download_endpoint = duckport_fixture('openstax', 'download_endpoint');

# Adapted from open-arrow-access-service 0.1.0 provider fixture tests.
# Binary preserves original bytes independently of filename extensions.

query I
SELECT octet_length(data) FROM duckport_scan_openstax('osbooks-biology-bundle', file_name := 'osbooks-biology-bundle.zip', endpoint := getvariable('fixture_endpoint'), revision := 'main', archive_endpoint := getvariable('fixture_download_endpoint'));
----
23

# Each prepared execution obtains an independent reader of the selected attachment.

statement ok
PREPARE provider_scan AS SELECT octet_length(data) FROM duckport_scan_openstax('osbooks-biology-bundle', file_name := 'osbooks-biology-bundle.zip', endpoint := getvariable('fixture_endpoint'), revision := 'main', archive_endpoint := getvariable('fixture_download_endpoint'));

query I
EXECUTE provider_scan;
----
23

query I
EXECUTE provider_scan;
----
23

statement error
SELECT * FROM duckport_scan_openstax('osbooks-biology-bundle', file_name := 'missing-file', endpoint := getvariable('fixture_endpoint'), revision := 'main', archive_endpoint := getvariable('fixture_download_endpoint'));
----
filename is absent from manifest

statement ok
DEALLOCATE provider_scan;

# Malformed metadata must fail without reading any attachment bytes.

statement ok
SET VARIABLE fixture_downloads_before = (SELECT count(*) FROM duckport_fixture_requests('openstax') WHERE is_download);

statement ok
SET VARIABLE fixture_requests_before = (SELECT count(*) FROM duckport_fixture_requests('openstax') WHERE origin = 'api');

query T
SELECT duckport_fixture('openstax', 'reject_metadata');
----
ok

# Invalid provider metadata must fail before downloading content.

statement error
SELECT octet_length(data) FROM duckport_scan_openstax('osbooks-biology-bundle', file_name := 'osbooks-biology-bundle.zip', endpoint := getvariable('fixture_endpoint'), revision := 'main', archive_endpoint := getvariable('fixture_download_endpoint'));
----
DuckPort

query T
SELECT count(*) = getvariable('fixture_downloads_before') FROM duckport_fixture_requests('openstax') WHERE is_download;
----
true

query T
SELECT count(*) > getvariable('fixture_requests_before') FROM duckport_fixture_requests('openstax') WHERE origin = 'api';
----
true

# Inspect the actual captured HTTP requests through native SQL.

query T
SELECT count(*) > 0 FROM duckport_fixture_requests('openstax') WHERE origin = 'api';
----
true

query T
SELECT count(*) > 0 FROM duckport_fixture_requests('openstax') WHERE origin = 'download';
----
true

query T
SELECT count(*) > 0 FROM duckport_fixture_requests('openstax') WHERE is_download;
----
true

query T
SELECT count(*) = 0 FROM duckport_fixture_requests('openstax') WHERE origin = 'api' AND has_authorization;
----
true

query T
SELECT count(*) = 0 FROM duckport_fixture_requests('openstax') WHERE origin = 'download' AND (has_authorization OR contains(headers, 'fixture-key') OR contains(target, 'fixture-key'));
----
true

query T
SELECT duckport_fixture('openstax', 'stop');
----
stopped
