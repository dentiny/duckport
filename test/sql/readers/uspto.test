require duckport

statement error
SELECT * FROM duckport_scan_uspto('test');
----
file_name is required

statement error
SELECT * FROM duckport_scan_uspto(NULL);
----
NULL

statement error
SELECT * FROM duckport_scan_uspto('test', file_name := NULL);
----
NULL
