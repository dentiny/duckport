query T
SELECT status FROM duckport_scan_doab('records', endpoint := getvariable('pages_endpoint'), auto_paginate := true, max_records := 1);
----
deleted

query T
SELECT identifier FROM duckport_scan_doab('empty-first', endpoint := getvariable('pages_endpoint'), auto_paginate := true);
----
id3
id4

query I
SELECT count(*) FROM duckport_scan_doab('records', endpoint := getvariable('pages_endpoint'), auto_paginate := true, max_pages := 3);
----
4

statement error
SELECT count(*) FROM duckport_scan_doab('records', endpoint := getvariable('pages_endpoint'), auto_paginate := true, max_pages := 2);
----
page limit reached

statement error
SELECT count(*) FROM duckport_scan_doab('loop', endpoint := getvariable('pages_endpoint'), auto_paginate := true);
----
repeated OAI resumption token

statement error
SELECT count(*) FROM duckport_scan_doab('error-next', endpoint := getvariable('pages_endpoint'), auto_paginate := true);
----
OAI protocol error

query T
SELECT "oai:header"."oai:identifier" FROM duckport_scan_doab('last', endpoint := getvariable('pages_endpoint'), auto_paginate := true, record_path := '/oai:OAI-PMH/oai:ListRecords/oai:record');
----
id3
id4

statement ok
SELECT duckport_fixture('oai_pagination', 'reset');

query I
SELECT count(*) FROM duckport_scan_doab('records', endpoint := getvariable('pages_endpoint'), auto_paginate := true, max_records := 1, batch_size := 2);
----
1

query I
SELECT count(*) FROM duckport_fixture_requests('oai_pagination') WHERE contains(target, 'resumptionToken');
----
0

