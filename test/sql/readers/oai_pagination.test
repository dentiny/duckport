statement ok
SELECT duckport_fixture('oai_pagination', 'reset');

query I
SELECT count(*) FROM duckport_scan_doab('records', endpoint := getvariable('pages_endpoint'), auto_paginate := true, from_date := '2026-01-01', until_date := '2026-02-01', set_spec := 'books');
----
4

query T
SELECT count(*) > 0 FROM duckport_fixture_requests('oai_pagination') WHERE target = '/oai/request?verb=ListRecords&resumptionToken=next%2Btoken%26x';
----
true

query I
SELECT count(*) FROM duckport_fixture_requests('oai_pagination') WHERE contains(target, 'resumptionToken') AND (contains(target, 'from=') OR contains(target, 'until=') OR contains(target, 'set='));
----
0

# A terminal empty harvest still has a bindable header schema.
query I
SELECT count(*) FROM duckport_scan_doab('none', endpoint := getvariable('pages_endpoint'), auto_paginate := true);
----
0

# Inference cannot silently change fields between pages.
statement error
SELECT * FROM duckport_scan_doab('records', endpoint := getvariable('pages_endpoint'), auto_paginate := true, record_path := '/oai:OAI-PMH/oai:ListRecords/oai:record');
----
OAI page schema changed

query T
SELECT duckport_fixture('oai_pagination', 'stop');
----
stopped

# Bearer credentials must be applied to every continuation request.
statement ok
SET VARIABLE pages_endpoint = duckport_fixture('oai_pagination', 'start_authenticated');

statement ok
CREATE SECRET pages_bearer (TYPE http, BEARER_TOKEN 'fixture-key', SCOPE getvariable('pages_endpoint'));

query I
SELECT count(*) FROM duckport_scan_oapen('records', endpoint := getvariable('pages_endpoint'), auto_paginate := true);
----
4

query T
SELECT count(*) > 0 AND bool_and("authorization" = 'Bearer fixture-key') FROM duckport_fixture_requests('oai_pagination') WHERE contains(target, 'resumptionToken');
----
true

statement ok
DROP SECRET pages_bearer;

query T
SELECT duckport_fixture('oai_pagination', 'stop');
----
stopped
