statement ok
PREPARE paged AS SELECT count(*) FROM duckport_scan_doab('records', endpoint := getvariable('pages_endpoint'), auto_paginate := true);

query I
EXECUTE paged;
----
4

query I
EXECUTE paged;
----
4

statement ok
DEALLOCATE paged;

statement error
SELECT * FROM duckport_scan_doab('records', endpoint := getvariable('pages_endpoint'), max_records := 1);
----
require auto_paginate

