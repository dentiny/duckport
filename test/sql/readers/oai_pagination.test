# name: test/sql/readers/oai_pagination.test
# description: Opt-in OAI continuation, limits, projection, errors and independent execution
# group: [sql]

require duckport
require duckport_test_fixture

statement ok
SET VARIABLE pages_endpoint = duckport_fixture('oai_pagination', 'start_anonymous');

# doab: include deleted records and continue across an empty page.
query T
SELECT identifier FROM duckport_scan_doab('records', endpoint := getvariable('pages_endpoint'), auto_paginate := true, batch_size := 1);
----
id1
id2
id3
id4

query I
SELECT count(*) FROM duckport_scan_doab('records', endpoint := getvariable('pages_endpoint'), auto_paginate := true);
----
4

query I
SELECT count(*) FROM duckport_scan_doab('records', endpoint := getvariable('pages_endpoint'));
----
2

query T
SELECT identifier FROM duckport_scan_doab('next+token&x', endpoint := getvariable('pages_endpoint'), auto_paginate := true);
----
id3
id4

# oapen: include deleted records and continue across an empty page.
query T
SELECT identifier FROM duckport_scan_oapen('records', endpoint := getvariable('pages_endpoint'), auto_paginate := true, batch_size := 1);
----
id1
id2
id3
id4

query I
SELECT count(*) FROM duckport_scan_oapen('records', endpoint := getvariable('pages_endpoint'), auto_paginate := true);
----
4

query I
SELECT count(*) FROM duckport_scan_oapen('records', endpoint := getvariable('pages_endpoint'));
----
2

query T
SELECT identifier FROM duckport_scan_oapen('next+token&x', endpoint := getvariable('pages_endpoint'), auto_paginate := true);
----
id3
id4

