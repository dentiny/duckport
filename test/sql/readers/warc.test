# name: test/sql/readers/warc.test
# description: Read physical WARC records and reject truncated data
# group: [sql]

require duckport

query TTT rowsort
SELECT record_id, record_type, decode(body) FROM duckport_scan_warc('testdata/warc/good_resources.warc', batch_size := 1);
----
<urn:test:a>	resource	123
<urn:test:b>	resource	456

query TTT
SELECT record_id, record_type, decode(body) FROM duckport_scan_warc('testdata/warc/good_metadata.warc');
----
<urn:test:one>	metadata	test

statement error
SELECT * FROM duckport_scan_warc('testdata/warc/bad_truncated_body.warc');
----
decode_warc
