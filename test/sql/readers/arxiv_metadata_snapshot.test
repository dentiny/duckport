# name: test/sql/readers/arxiv_metadata_snapshot.test
# description: arXiv PDFs retain every cached metadata field and require complete ID matches
# group: [sql]

require duckport

require parquet

query TTITT
SELECT metadata.identifier, metadata.title, octet_length(data),
       metadata.attributes.category, metadata.submitted::VARCHAR
FROM duckport_scan_arxiv('testdata/arxiv', kind := 'pdf', month := '2410',
    metadata_uri := 'testdata/arxiv/metadata.parquet', batch_size := 1)
ORDER BY metadata.title;
----
oai:arXiv.org:2410.01234	First	10	cs.AI	2024-10-01
2410.01235	Second	11	cs.LG	2024-10-02

query I
SELECT len(metadata.authors) FROM duckport_scan_arxiv('testdata/arxiv', kind := 'pdf',
    metadata_uri := 'testdata/arxiv/metadata.parquet') ORDER BY metadata.title;
----
1
2

# Both cached metadata and PDF bytes are written to one dataset with no URL conversion.
statement ok
COPY (SELECT * FROM duckport_scan_arxiv('testdata/arxiv', kind := 'pdf',
    metadata_uri := 'testdata/arxiv/metadata.parquet'))
TO '{TEST_DIR}/arxiv_joined' (FORMAT duckport_parquet);

query TII
SELECT string_agg(metadata.title, ',' ORDER BY metadata.title), count(*), sum(octet_length(data))
FROM read_parquet('{TEST_DIR}/arxiv_joined/*.parquet');
----
First,Second	2	21

# Alternate string ID columns retain their original names and all other snapshot fields.
statement ok
COPY (SELECT identifier AS article_id, title FROM read_parquet('testdata/arxiv/metadata.parquet'))
TO '{TEST_DIR}/arxiv_custom_ids.parquet' (FORMAT PARQUET);

query I
SELECT count(*) FROM duckport_scan_arxiv('testdata/arxiv', kind := 'pdf',
    metadata_uri := '{TEST_DIR}/arxiv_custom_ids.parquet', metadata_id_column := 'article_id');
----
2

statement error metadata_id_column requires metadata_uri
SELECT * FROM duckport_scan_arxiv('testdata/arxiv', kind := 'pdf', metadata_id_column := 'identifier');

statement error arXiv metadata snapshots require kind=pdf
SELECT * FROM duckport_scan_arxiv('testdata/arxiv', metadata_uri := 'testdata/arxiv/metadata.parquet');

statement error arXiv metadata snapshots require kind=pdf
SELECT * FROM duckport_scan_arxiv('testdata/arxiv', kind := 'auto', metadata_uri := 'testdata/arxiv/metadata.parquet');

statement error metadata_uri must name one Parquet snapshot without wildcards
SELECT * FROM duckport_scan_arxiv('testdata/arxiv', kind := 'pdf', metadata_uri := 'testdata/arxiv/*.parquet');

statement error metadata_uri must name one Parquet snapshot without wildcards
SELECT * FROM duckport_scan_arxiv('testdata/arxiv', kind := 'pdf', metadata_uri := 'testdata/arxiv/');

statement error metadata_id_column must not be empty
SELECT * FROM duckport_scan_arxiv('testdata/arxiv', kind := 'pdf',
    metadata_uri := 'testdata/arxiv/metadata.parquet', metadata_id_column := ' ');

statement error metadata ID column is missing
SELECT * FROM duckport_scan_arxiv('testdata/arxiv', kind := 'pdf',
    metadata_uri := 'testdata/arxiv/metadata.parquet', metadata_id_column := 'missing');

statement ok
COPY (SELECT * FROM read_parquet('testdata/arxiv/metadata.parquet') WHERE title = 'First')
TO '{TEST_DIR}/arxiv_missing.parquet' (FORMAT PARQUET);

# A zero-column scan still validates every PDF's metadata match.
statement error PDF has no matching metadata in the snapshot
SELECT count(*) FROM duckport_scan_arxiv('testdata/arxiv', kind := 'pdf',
    metadata_uri := '{TEST_DIR}/arxiv_missing.parquet');

statement ok
COPY (SELECT * FROM read_parquet('testdata/arxiv/metadata.parquet')
      UNION ALL SELECT * FROM read_parquet('testdata/arxiv/metadata.parquet'))
TO '{TEST_DIR}/arxiv_duplicate.parquet' (FORMAT PARQUET);

statement error duplicate arXiv metadata ID
SELECT count(*) FROM duckport_scan_arxiv('testdata/arxiv', kind := 'pdf',
    metadata_uri := '{TEST_DIR}/arxiv_duplicate.parquet');

statement ok
COPY (SELECT NULL::VARCHAR AS identifier)
TO '{TEST_DIR}/arxiv_null_id.parquet' (FORMAT PARQUET);

statement error metadata ID cannot be null
SELECT count(*) FROM duckport_scan_arxiv('testdata/arxiv', kind := 'pdf',
    metadata_uri := '{TEST_DIR}/arxiv_null_id.parquet');

statement ok
COPY (SELECT * FROM duckport_scan_arxiv('testdata/arxiv', kind := 'pdf',
    metadata_uri := 'testdata/arxiv/metadata.parquet'))
TO '{TEST_DIR}/arxiv_joined.lance' (FORMAT duckport_lance);

restart no_extension_load

statement ok
LOAD '{BUILD_DIRECTORY}/extension/lance/lance.duckdb_extension';

query TITT
SELECT metadata.title, octet_length(data), metadata.attributes.category,
       metadata.submitted::VARCHAR
FROM '{TEST_DIR}/arxiv_joined.lance' ORDER BY metadata.title;
----
First	10	cs.AI	2024-10-01
Second	11	cs.LG	2024-10-02
