# name: test/sql/readers/arxiv_metadata_empty.test
# description: Empty arXiv metadata pages bind to fixed OAI header columns
# group: [sql]

require duckport
require duckport_test_fixture

statement ok
SET VARIABLE arxiv_empty_endpoint = duckport_fixture('arxiv_metadata', 'start_anonymous');

# No inferred fields exist for an empty page. The default still binds with the
# standard upstream header schema, and every header can be projected.
query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM duckport_scan_arxiv_metadata('records', endpoint := getvariable('arxiv_empty_endpoint'), from_date := '2026-02-01'));
----
identifier	VARCHAR
datestamp	VARCHAR
status	VARCHAR
set_specs	VARCHAR[]

query IIII
SELECT count(identifier), count(datestamp), count(status), count(set_specs) FROM duckport_scan_arxiv_metadata('records', endpoint := getvariable('arxiv_empty_endpoint'), from_date := '2026-02-01');
----
0	0	0	0

# OAI noRecordsMatch is also a successful empty page with the same schema.
query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM duckport_scan_arxiv_metadata('records', endpoint := getvariable('arxiv_empty_endpoint'), from_date := '2026-02-02'));
----
identifier	VARCHAR
datestamp	VARCHAR
status	VARCHAR
set_specs	VARCHAR[]

query IIII
SELECT count(identifier), count(datestamp), count(status), count(set_specs) FROM duckport_scan_arxiv_metadata('records', endpoint := getvariable('arxiv_empty_endpoint'), from_date := '2026-02-02');
----
0	0	0	0

# An explicit record path keeps the requested envelope instead of the fallback.
query T
SELECT "oai:resumptionToken" FROM duckport_scan_arxiv_metadata('records', endpoint := getvariable('arxiv_empty_endpoint'), from_date := '2026-02-01', record_path := '/oai:OAI-PMH/oai:ListRecords');
----
empty+next

query I
SELECT count(*) FROM duckport_scan_arxiv_metadata('records', endpoint := getvariable('arxiv_empty_endpoint'), from_date := '2026-02-02', record_path := '/oai:OAI-PMH');
----
1

query T
SELECT duckport_fixture('arxiv_metadata', 'stop');
----
stopped
