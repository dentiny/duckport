# name: test/sql/readers/http_source_auth.test
# description: HTTP file readers reselect scoped credentials on redirects
# group: [sql]

require duckport

require duckport_test_fixture

statement ok
SET VARIABLE source_endpoint = duckport_fixture('blob_http', 'start_anonymous');

statement ok
CREATE SECRET source_bearer (TYPE http, BEARER_TOKEN 'fixture-key', SCOPE getvariable('source_endpoint') || '/private/');

statement ok
CREATE SECRET source_narrow (TYPE http, BEARER_TOKEN 'fixture-narrow', SCOPE getvariable('source_endpoint') || '/private/narrow/');

statement ok
CREATE SECRET source_custom (TYPE http, EXTRA_HTTP_HEADERS MAP {'X-API-Key': 'fixture-custom'}, SCOPE getvariable('source_endpoint') || '/api-key/');

statement ok
CREATE SECRET source_custom_narrow (TYPE http, EXTRA_HTTP_HEADERS MAP {'X-API-Key': 'fixture-custom-narrow'}, SCOPE getvariable('source_endpoint') || '/api-key/narrow/');

# Ordinary files and Blob downloads use the same longest-scope resolver.

query I
SELECT id FROM duckport_scan_json(getvariable('source_endpoint') || '/api-key/records.json');
----
1

query I
SELECT id FROM duckport_scan_json(getvariable('source_endpoint') || '/private/to-narrow.json');
----
1

query I
SELECT id FROM duckport_scan_json(getvariable('source_endpoint') || '/api-key/to-narrow.json');
----
1

# Leaving a scope on the same origin removes both bearer and custom headers.

query I
SELECT id FROM duckport_scan_json(getvariable('source_endpoint') || '/private/to-public.json');
----
1

query I
SELECT id FROM duckport_scan_json(getvariable('source_endpoint') || '/api-key/to-public.json');
----
1

query T
SELECT count(*) > 0 AND bool_and(NOT has_authorization AND NOT contains(headers, 'fixture-'))
FROM duckport_fixture_requests('blob_http') WHERE target = '/public/records.json';
----
true

# An initially anonymous URL must still acquire the target scope's credentials.

query I
SELECT id FROM duckport_scan_json(getvariable('source_endpoint') || '/public/to-private.json');
----
1

# Cross-origin redirects never acquire even a matching destination credential.

statement ok
CREATE SECRET source_cross (TYPE http, BEARER_TOKEN 'fixture-cross', SCOPE 'http://127.0.0.1:');

query I
SELECT id FROM duckport_scan_json(getvariable('source_endpoint') || '/private/to-cross.json');
----
1

query T
SELECT count(*) > 0 AND bool_and(NOT has_authorization AND NOT contains(headers, 'fixture-'))
FROM duckport_fixture_requests('blob_http') WHERE origin = 'download';
----
true

# Credentials remain disabled when a cross-origin chain returns to the first origin.

statement error
SELECT id FROM duckport_scan_json(getvariable('source_endpoint') || '/private/to-cross-return.json');
----
DuckPort

statement ok
DROP SECRET source_cross;

statement ok
DROP SECRET source_bearer;

statement ok
DROP SECRET source_narrow;

statement ok
DROP SECRET source_custom;

statement ok
DROP SECRET source_custom_narrow;

query T
SELECT duckport_fixture('blob_http', 'stop');
----
stopped
