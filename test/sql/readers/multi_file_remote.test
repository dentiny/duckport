# name: test/sql/readers/multi_file_remote.test
# description: Multi-file discovery and reads independently resolve source secrets
# group: [sql]

require duckport

require duckport_test_fixture

require httpfs

statement ok
SET VARIABLE multi_endpoint = duckport_fixture('blob_s3', 'start_anonymous');

foreach key,path a,source-a b,source-b c,source-a/narrow

statement ok
CREATE SECRET multi_{key} (TYPE s3, KEY_ID 'key-{key}', SECRET 'secret-{key}', SESSION_TOKEN 'session-{key}',
    ENDPOINT substring(getvariable('multi_endpoint'), 8), USE_SSL false, URL_STYLE 'path', SCOPE 's3://{path}/');

endloop

query II
SELECT count(*), sum(id) FROM duckport_scan_json(['s3://source-a/a.json', 's3://source-b/b.json', 's3://source-a/narrow/c.json']);
----
3	6

query II
SELECT count(*), sum(id) FROM duckport_scan_json('s3://source-a/');
----
2	4

query II
SELECT count(*), sum(id) FROM duckport_scan_json('s3://source-a/*.json');
----
1	1

# A single-component glob lists only immediate children (S3 delimiter=/).
query T
SELECT bool_or(contains(target, 'delimiter=%2F') OR contains(target, 'delimiter=/'))
FROM duckport_fixture_requests('blob_s3') WHERE contains(target, 'list-type=2');
----
true

# A file-prefix secret must never be used to list its parent directory.
statement ok
CREATE SECRET multi_file_only (TYPE s3, KEY_ID 'wrong-file', SECRET 'wrong-file-secret',
    ENDPOINT substring(getvariable('multi_endpoint'), 8), USE_SSL false, URL_STYLE 'path', SCOPE 's3://source-a/a');

statement error
SELECT * FROM duckport_scan_json('s3://source-a/a*.json');
----
DuckPort

query T
SELECT count(*) > 0 AND bool_and(NOT contains("authorization", 'wrong-file'))
FROM duckport_fixture_requests('blob_s3') WHERE contains(target, 'list-type=2');
----
true

statement ok
DROP SECRET multi_file_only;

# Discovery may not normalize beyond the selected credential scope.
foreach parent .. %2e%2e

statement error
SELECT * FROM duckport_scan_json('s3://source-a/narrow/{parent}/*.json');
----
S3 selections cannot contain dot path segments

endloop

foreach key a b c

statement ok
DROP SECRET multi_{key};

endloop

# URI-escaped metacharacters select literal keys, not similarly named objects.
statement ok
CREATE SECRET literal_sources (TYPE s3, KEY_ID 'key-a', SECRET 'secret-a', SESSION_TOKEN 'session-a',
    ENDPOINT substring(getvariable('multi_endpoint'), 8), USE_SSL false, URL_STYLE 'path', SCOPE 's3://literal-files/');

statement ok
SELECT duckport_fixture('blob_s3', 'reset');

foreach prefix data%5B1%5D star%2a question%3F literal%5b

query I
SELECT id FROM duckport_scan_json('s3://literal-files/{prefix}.json');
----
1

endloop

# Exact encoded keys must never trigger bucket listing.
query I
SELECT count(*) FROM duckport_fixture_requests('blob_s3') WHERE contains(target, 'list-type=2');
----
0

# Raw wildcards still work alongside escaped literals; decoys have id=3.
foreach prefix data%5B1%5D star%2a question%3F literal%5b

query I
SELECT id FROM duckport_scan_json('s3://literal-files/{prefix}*.json');
----
1

endloop

statement ok
DROP SECRET literal_sources;

query T
SELECT duckport_fixture('blob_s3', 'stop');
----
stopped

statement ok
SET VARIABLE multi_http = duckport_fixture('blob_http', 'start_anonymous');

statement ok
CREATE SECRET multi_http_a (TYPE http, BEARER_TOKEN 'fixture-key', SCOPE getvariable('multi_http') || '/private/');

statement ok
CREATE SECRET multi_http_b (TYPE http, BEARER_TOKEN 'fixture-narrow', SCOPE getvariable('multi_http') || '/private/narrow/');

query II
SELECT count(*), sum(id) FROM duckport_scan_json([
    getvariable('multi_http') || '/private/to-narrow.json',
    getvariable('multi_http') || '/private/narrow/records.json',
    getvariable('multi_http') || '/public/records.json']);
----
3	3

# Encoded brackets (including an unmatched bracket), stars and question marks
# are ordinary HTTP file paths. HTTP provides no listing fallback.
query II
SELECT count(*), sum(id) FROM duckport_scan_json([
    getvariable('multi_http') || '/public/data%5B1%5D.json',
    getvariable('multi_http') || '/public/star%2A.json',
    getvariable('multi_http') || '/public/question%3f.json',
    getvariable('multi_http') || '/public/literal%5B.json']);
----
4	4

# HTTP does not expose directory listing, but explicit HTTP file lists work.
statement error
SELECT * FROM duckport_scan_json(getvariable('multi_http') || '/*.json');
----
list

foreach key a b

statement ok
DROP SECRET multi_http_{key};

endloop

query T
SELECT duckport_fixture('blob_http', 'stop');
----
stopped
