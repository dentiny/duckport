# Adapted from open-arrow-access-service 0.1.0 provider fixture tests.
# Binary preserves original bytes independently of filename extensions.
query I
SELECT octet_length(data) FROM duckport_scan_govinfo('FR/2026', file_name := 'issue.xml', endpoint := '__ENDPOINT__');
----
23

# Each prepared execution obtains an independent reader of the selected attachment.
statement ok
PREPARE provider_scan AS SELECT octet_length(data) FROM duckport_scan_govinfo('FR/2026', file_name := 'issue.xml', endpoint := '__ENDPOINT__');

query I
EXECUTE provider_scan;
----
23

query I
EXECUTE provider_scan;
----
23

query IT rowsort
SELECT id, name FROM duckport_scan_govinfo('FR/2026', file_name := 'issue.xml', endpoint := '__ENDPOINT__', format := 'csv', batch_size := 1);
----
1	alpha
2	beta

statement error
SELECT * FROM duckport_scan_govinfo('FR/2026', file_name := 'missing-file', endpoint := '__ENDPOINT__');
----
filename is absent from manifest

statement error
SELECT * FROM duckport_scan_govinfo('FR/2026', file_name := 'issue.xml', endpoint := '__ENDPOINT__', format := 'invalid');
----
format must be

statement error
SELECT * FROM duckport_scan_govinfo('FR/2026', file_name := 'issue.xml', endpoint := '__ENDPOINT__', format := 'xml');
----
record_path is required
