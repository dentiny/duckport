# Adapted from open-arrow-access-service 0.1.0 provider fixture tests.
# Binary preserves original bytes independently of filename extensions.
query I
SELECT octet_length(data) FROM duckport_scan_openstax('osbooks-biology-bundle', file_name := 'osbooks-biology-bundle.zip', endpoint := '__ENDPOINT__', revision := 'main', archive_endpoint := '__DOWNLOAD__');
----
23

# Each prepared execution obtains an independent reader of the selected attachment.
statement ok
PREPARE provider_scan AS SELECT octet_length(data) FROM duckport_scan_openstax('osbooks-biology-bundle', file_name := 'osbooks-biology-bundle.zip', endpoint := '__ENDPOINT__', revision := 'main', archive_endpoint := '__DOWNLOAD__');

query I
EXECUTE provider_scan;
----
23

query I
EXECUTE provider_scan;
----
23

statement error
