# Adapted from open-arrow-access-service 0.1.0 provider fixture tests.
# Binary preserves original bytes independently of filename extensions.
query I
SELECT octet_length(data) FROM duckport_scan_uspto('PTGRXML', file_name := 'grant.zip', endpoint := '__ENDPOINT__');
----
23

# Each prepared execution obtains an independent reader of the selected attachment.
statement ok
PREPARE provider_scan AS SELECT octet_length(data) FROM duckport_scan_uspto('PTGRXML', file_name := 'grant.zip', endpoint := '__ENDPOINT__');

query I
EXECUTE provider_scan;
----
23

query I
EXECUTE provider_scan;
----
23

statement error
SELECT * FROM duckport_scan_uspto('PTGRXML', file_name := 'missing-file', endpoint := '__ENDPOINT__');
----
filename is absent from manifest

statement error
SELECT * FROM duckport_scan_uspto('PTGRXML', file_name := 'grant.zip', endpoint := '__ENDPOINT__', format := 'invalid');
----
format must be

statement error
SELECT * FROM duckport_scan_uspto('PTGRXML', file_name := 'grant.zip', endpoint := '__ENDPOINT__', format := 'xml');
----
record_path is required
