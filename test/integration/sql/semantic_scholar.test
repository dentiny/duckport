# Adapted from open-arrow-access-service 0.1.0 provider fixture tests.
# Binary preserves original bytes independently of filename extensions.
query I
SELECT octet_length(data) FROM duckport_scan_semantic_scholar('s2orc', file_name := 'part-00000', endpoint := '__ENDPOINT__', release := 'latest');
----
23

# Each prepared execution obtains an independent reader of the selected attachment.
statement ok
PREPARE provider_scan AS SELECT octet_length(data) FROM duckport_scan_semantic_scholar('s2orc', file_name := 'part-00000', endpoint := '__ENDPOINT__', release := 'latest');

query I
EXECUTE provider_scan;
----
23

query I
EXECUTE provider_scan;
----
23

query IT rowsort
SELECT id, name FROM duckport_scan_semantic_scholar('s2orc', file_name := 'part-00000', endpoint := '__ENDPOINT__', release := 'latest', format := 'csv', batch_size := 1);
----
1	alpha
2	beta

