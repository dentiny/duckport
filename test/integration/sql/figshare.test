# Adapted from open-arrow-access-service 0.1.0 provider fixture tests.
# Binary preserves original bytes independently of filename extensions.
query I
SELECT octet_length(data) FROM duckport_scan_figshare('21422193', file_name := 'ocr.txt.gz', endpoint := '__ENDPOINT__', version := '4');
----
23

# Each prepared execution obtains an independent reader of the selected attachment.
statement ok
PREPARE provider_scan AS SELECT octet_length(data) FROM duckport_scan_figshare('21422193', file_name := 'ocr.txt.gz', endpoint := '__ENDPOINT__', version := '4');

query I
EXECUTE provider_scan;
----
23

query I
EXECUTE provider_scan;
----
23

statement error
SELECT * FROM duckport_scan_figshare('21422193', file_name := 'missing-file', endpoint := '__ENDPOINT__', version := '4');
----
filename is absent from manifest

statement error
SELECT * FROM duckport_scan_figshare('21422193', file_name := 'ocr.txt.gz', endpoint := '__ENDPOINT__', version := '4', format := 'invalid');
----
format must be

statement error
SELECT * FROM duckport_scan_figshare('21422193', file_name := 'ocr.txt.gz', endpoint := '__ENDPOINT__', version := '4', format := 'xml');
----
record_path is required
